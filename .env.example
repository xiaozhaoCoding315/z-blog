# 数据库（本地开发默认值与 docker-compose 中 db 服务一致）
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
DB_PASSWORD=blog

# AI（双供应商，均走 OpenAI 兼容协议；留空则对应功能自动降级）
# 聊天/摘要：智谱 GLM（https://open.bigmodel.cn 注册）
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4.6
# 向量化：阿里云百炼 text-embedding-v3（默认 1024 维，https://bailian.console.aliyun.com）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMS=1024

# 同步接口密钥（Docker entrypoint 自动调用 /api/sync 时携带）
# 必须换成随机值（openssl rand -hex 32）；留空则 /api/sync 拒绝所有调用
SYNC_SECRET=

# 站点信息（可留空使用 src/config/site.ts 中的默认值）
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_START_DATE=2026-07-02
# 联系邮箱：留空则「关于」页不显示邮箱入口
NEXT_PUBLIC_CONTACT_EMAIL=

# Giscus 评论（到 https://giscus.app 生成后填入；留空则不显示评论区）
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# GitHub 登录（面试题库的掌握度同步用；留空则进度只存浏览器本地）
# 创建入口：https://github.com/settings/developers → New OAuth App
#   Application name : 随便填（如 Z Blog）
#   Homepage URL     : http://你的域名
#   Authorization callback URL: http://你的域名/api/auth/github/callback
# ⚠️ 回调地址必须与上面填的完全一致，多一个斜杠都会失败
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 会话签名密钥（openssl rand -hex 32）
# 留空则回退到 SYNC_SECRET；两个都空时登录功能不可用
AUTH_SECRET=

# 邮箱验证码登录（QQ 邮箱：设置 → 账户 → 开启 SMTP，拿到的是授权码不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 站长邮箱：只有这个邮箱登录后是 owner，能发动态
OWNER_EMAIL=
