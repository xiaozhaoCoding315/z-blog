# 数据库（本地开发默认值与 docker-compose 中 db 服务一致）
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
DB_PASSWORD=blog

# AI（双供应商，均走 OpenAI 兼容协议；留空则对应功能自动降级）
# 聊天/摘要：智谱 GLM（https://open.bigmodel.cn 注册）
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4.6
# 向量化：阿里云百炼 text-embedding-v3（默认 1024 维，https://bailian.console.aliyun.com）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMS=1024

# 同步接口密钥（Docker entrypoint 自动调用 /api/sync 时携带）
# 必须换成随机值（openssl rand -hex 32）；留空则 /api/sync 返回 503，容器启动时跳过自动同步；Docker 部署必须设置
SYNC_SECRET=

# 站点信息（可留空使用 src/config/site.ts 中的默认值）
NEXT_PUBLIC_SITE_NAME=
# 上线必须是 https://…，否则登录 cookie 不会带 Secure；构建期内联，改完需重新构建
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_START_DATE=2026-07-02
# 联系邮箱：留空则「关于」页不显示邮箱入口
NEXT_PUBLIC_CONTACT_EMAIL=

# GitHub OAuth：历史遗留路由，站内没有 UI 入口；当前登录使用邮箱验证码。
# 保留变量仅为兼容旧路由，可以留空。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 会话签名密钥（openssl rand -hex 32）
# 留空则回退到 SYNC_SECRET；两个都空时登录功能不可用
AUTH_SECRET=

# 邮箱验证码登录（QQ 邮箱：设置 → 账户 → 开启 SMTP，拿到的是授权码不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 站长邮箱：只有这个邮箱登录后是 owner，能发动态
OWNER_EMAIL=
